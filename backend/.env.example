# Configuration du Serveur API
PORT=5000
NODE_ENV=development

# Base de données MySQL (Prisma)
# Modifier avec l'hôte, le port, le nom d'utilisateur, le mot de passe et le nom de la base de données.
DATABASE_URL="mysql://gtk_user:gtk_password@localhost:3306/karochebama"

# Cache Redis
REDIS_URL="redis://localhost:6379"

# Clés secrètes JWT (générer des chaînes aléatoires complexes en production)
JWT_ACCESS_SECRET="default_access_secret_should_be_replaced_in_production_with_uuid_or_similar"
JWT_REFRESH_SECRET="default_refresh_secret_should_be_replaced_in_production_with_uuid_or_similar"

# Stockage Object Storage compatible S3 (AWS, Scaleway, OVH, etc.)
S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"
S3_ACCESS_KEY_ID="your_aws_access_key_id"
S3_SECRET_ACCESS_KEY="your_aws_secret_access_key"
S3_BUCKET_NAME="karochebama-uploads-bucket"
S3_REGION="eu-west-3"
