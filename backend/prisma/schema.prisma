datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id         String      @id @default(uuid())
  name       String
  slug       String      @unique @db.VarChar(191)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?   // Soft delete
  users      User[]
  products   Product[]
  harvests   Harvest[]
  projects   Project[]
  orders     Order[]
  invoices   Invoice[]
  blogs      Blog[]
  mediaFiles MediaFile[]

  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(191)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(191)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique @db.VarChar(191)
  passwordHash   String
  firstName      String?
  lastName       String?
  roleId         String
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?      // Soft delete
  isEmailVerified Boolean       @default(false)
  refreshTokens  RefreshToken[]
  orders         Order[]
  blogs          Blog[]
  mediaFiles     MediaFile[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([roleId])
  @@index([organizationId, deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique @db.VarChar(255)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique @db.VarChar(191)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete
  products    Product[]

  @@index([deletedAt])
}

model Product {
  id             String       @id @default(uuid())
  name           String
  price          Decimal      @db.Decimal(10, 2)
  sku            String?      @db.VarChar(50)
  description    String?      @db.Text
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete
  imageUrl       String?      @db.Text
  harvests       Harvest[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Harvest {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal      @db.Decimal(12, 4)
  unit           String       @db.VarChar(20) // Régime, tonnes, litres, etc.
  harvestDate    DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete

  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?      @db.Text
  status         String       @db.VarChar(30) // PLANNED, ACTIVE, COMPLETED, SUSPENDED
  startDate      DateTime?
  endDate        DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Order {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @db.VarChar(30) // PENDING, PAID, SHIPPED, CANCELLED, REFUNDED
  totalAmount    Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete
  items          OrderItem[]
  invoice        Invoice?

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal  @db.Decimal(10, 2)
  price     Decimal  @db.Decimal(10, 2) // Prix historique lors de l'achat
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id             String       @id @default(uuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String       @unique @db.VarChar(50)
  amount         Decimal      @db.Decimal(12, 2)
  status         String       @db.VarChar(30) // DRAFT, SENT, PAID, OVERDUE, VOIDED
  issuedAt       DateTime     @default(now())
  dueDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete

  @@index([orderId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Blog {
  id             String       @id @default(uuid())
  title          String       @db.VarChar(255)
  slug           String       @unique @db.VarChar(255)
  content        String       @db.LongText
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete

  @@index([authorId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model MediaFile {
  id             String       @id @default(uuid())
  url            String       @db.Text
  key            String       @db.VarChar(512) // Cle unique S3
  mimeType       String       @db.VarChar(100)
  size           Int          // Taille en octets
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Soft delete

  @@index([uploadedById])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // Nullable pour les actions anonymes (ex: echec de connexion)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100) // Ex: product:create, user:login
  entityName String   @db.VarChar(100) // Ex: Product, Order
  entityId   String?  @db.VarChar(100)
  oldValues  Json?    // MySQL native Json block
  newValues  Json?    // MySQL native Json block
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityName, entityId])
  @@index([createdAt])
}
